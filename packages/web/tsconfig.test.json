// Compila só a lógica pura do painel (src/lib) para node:test.
//
// O que mora em src/lib não pode depender de navegador nem de React — é isso
// que permite testá-lo sem jsdom. Sai em dist-test/ e não em dist/: dist/ é a
// build do Vite que o daemon serve, e o Vite a apaga a cada build.
// `npm test` acha os *.test.js daqui via scripts/run-tests.mjs.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src/lib",
    "outDir": "dist-test",
    "tsBuildInfoFile": "dist-test/.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["src/lib/**/*.ts"],
  "references": [{ "path": "../core" }, { "path": "../client" }]
}
