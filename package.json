{
  "name": "agents-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plano de controle onde qualquer agente de IA pode orquestrar e ser orquestrado.",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build --workspace @agents-hub/web",
    "build:watch": "tsc -b --watch",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b && npm run typecheck --workspace @agents-hub/web",
    "daemon": "node --experimental-sqlite packages/daemon/dist/main.js",
    "hub": "node packages/cli/dist/main.js",
    "test": "node scripts/run-tests.mjs",
    "build:packages": "tsc -b",
    "web:dev": "npm run dev --workspace @agents-hub/web",
    "verify": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.7.2",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  }
}
